# ============================================================
# project_ginger-finance — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Variables marked REQUIRED must be set for the app to start.
# ============================================================

# ------------------------------------------------------------
# MongoDB  (REQUIRED)
# ------------------------------------------------------------

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017

# Database name (default: ginger-finance)
MONGODB_DB_NAME=ginger-finance

# ------------------------------------------------------------
# Authentication  (REQUIRED)
# ------------------------------------------------------------

# JWT signing secret — use a long random string (64+ chars) in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ------------------------------------------------------------
# Application URLs
# ------------------------------------------------------------

# Frontend URL — used in email invitation / reset links
APP_URL=http://localhost:3000

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Bootstrap  (first run only)
# ------------------------------------------------------------

# Email address to auto-create the super admin account on startup
SEED_SUPER_ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------
# SMTP / Email  (REQUIRED for invitation and notification emails)
# ------------------------------------------------------------

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Set to true only when using port 465 (implicit TLS)
SMTP_SECURE=false

# SMTP login credentials
SMTP_EMAIL=your-address@gmail.com
SMTP_PASSWORD=your-app-password

# Sender display name and address shown to recipients
MAIL_FROM="Ginger Finance <noreply@ginger.app>"
